# Copy to .env and provide development credentials. Never commit real values.
NODE_ENV=development
PORT=5000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test-mode keys for local development. Secret values are backend-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Backend-only Resend credentials. The sender must be verified in Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# IANA business timezone; cron runs at 08:00 local time on day 1 by default.
APP_TIMEZONE=Asia/Kuala_Lumpur
MONTHLY_REPORT_CRON=0 8 1 * *

# Comma-separated exact origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info

# Optional integration suite. Use a disposable project only; immutable ledger rows are retained.
TEST_SUPABASE_URL=
TEST_SUPABASE_ANON_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_SUPABASE_DISPOSABLE=false
