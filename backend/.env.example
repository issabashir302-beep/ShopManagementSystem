# Copy to .env and provide development credentials. Never commit real values.
NODE_ENV=development
PORT=5000

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated exact origins. Wildcards are rejected in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=info
