{
  "name": "backend",
  "version": "1.0.0",
  "description": "Shopwise MiniPOS API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-isolation=none --test-concurrency=1 src/**/*.test.js",
    "test:integration": "node --test --test-isolation=none --test-concurrency=1 tests/integration/*.integration.test.js",
    "test:coverage": "node --test --test-isolation=none --test-concurrency=1 --experimental-test-coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.89.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "resend": "^6.19.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "prettier": "^3.9.6"
  }
}
